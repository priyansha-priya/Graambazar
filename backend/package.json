{
  "name": "grambazaar-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Express + Drizzle ORM + Cloud SQL PostgreSQL + Firebase Admin backend for GramBazaar",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase-admin": "^13.7.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
