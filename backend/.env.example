# GramBazaar Backend Environment Configuration
# Copy this file to backend/.env for local standalone runs.
# NEVER commit real passwords or service account credentials.

# Standalone HTTP server port (AI Studio preview mounts backend on root port 3000)
PORT=4000

# Allowed frontend origins (comma-separated, e.g. http://localhost:3000,https://your-domain.com)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / Cloud SQL connection (Option A: discrete params)
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=grambazaar

# PostgreSQL connection (Option B: single connection URL, used if SQL_HOST is unset)
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/grambazaar

# Firebase Project ID for ID token verification (falls back to root firebase-applet-config.json)
FIREBASE_PROJECT_ID=
