  VILLAGE_SELLERS
}

Enum broadcast_priority {
  NORMAL
  FESTIVE
  URGENT_ALERT
}

Enum broadcast_status {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

Enum banner_placement {
  HERO_CAROUSEL
  MID_PROMO
  FESTIVAL_STRIP
}

// ============================================================================
// DOMAIN 1: IDENTITY, AUTH & RBAC
// ============================================================================

Table users {
  id uuid [pk]
  full_name varchar(120) [not null]
  phone varchar(15) [unique, not null]
  email varchar(255) [unique]
  password_hash text [not null]
  avatar_url text
  active_village_id uuid [ref: > villages.id]
  status user_status [not null, default: 'ACTIVE']
  block_reason text
  admin_notes text
  terms_accepted_at timestamptz
  phone_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table roles {
  id uuid [pk]
  code role_code [unique, not null]
  name varchar(80) [not null]
  description text
  is_system boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table user_roles {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  assigned_by_user_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, role_id) [unique]
  }
}

Table role_permissions {
  id uuid [pk]
  role_id uuid [not null, ref: > roles.id]
  module_key varchar(60) [not null]
  can_view boolean [not null, default: false]
  can_manage boolean [not null, default: false]
  can_approve boolean [not null, default: false]
  can_export boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, module_key) [unique]
  }
}

Table admin_village_scopes {
  user_id uuid [not null, ref: > users.id]
  village_id uuid [not null, ref: > villages.id]
  assigned_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, village_id) [pk]
  }
}

Table auth_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_type auth_token_type [not null]
  token_hash varchar(128) [unique, not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]
}

TableGroup Identity_Auth_RBAC {
  users
  roles
  user_roles
  role_permissions
  admin_village_scopes
  auth_tokens
}

// ============================================================================
// DOMAIN 2: GEOGRAPHY & RURAL ADDRESSES
// ============================================================================

Table villages {
  id uuid [pk]
  code varchar(40) [unique, not null]
  name varchar(120) [not null]
  hindi_name varchar(120)
  district varchar(100) [not null]
  state varchar(100) [not null]
  postal_codes text[] [not null]
  base_delivery_fee numeric(12,2) [not null, default: 0.00]
  min_order_free_delivery numeric(12,2) [not null, default: 0.00]
  latitude numeric(9,6)
  longitude numeric(9,6)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (name, district, state) [unique]
  }
}

Table village_landmarks {
  id uuid [pk]
  village_id uuid [not null, ref: > villages.id]
  name varchar(150) [not null]
  hindi_name varchar(150)
  is_popular boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (village_id, name) [unique]
  }
}

Table inter_village_routes {
  id uuid [pk]
  from_village_id uuid [not null, ref: > villages.id]
  to_village_id uuid [not null, ref: > villages.id]
  distance_km numeric(6,2) [not null]
  surcharge_amount numeric(12,2) [not null, default: 0.00]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (from_village_id, to_village_id) [unique]
  }
}

Table customer_addresses {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  village_id uuid [not null, ref: > villages.id]
  recipient_name varchar(120) [not null]
  recipient_phone varchar(15) [not null]
  address_line1 varchar(255) [not null]
  landmark varchar(200) [not null, note: 'Mandatory for village doorstep delivery']
  address_label address_label [not null, default: 'HOME']
  latitude numeric(9,6)
  longitude numeric(9,6)
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

TableGroup Geography_Locations {
  villages
  village_landmarks
  inter_village_routes
  customer_addresses
}

// ============================================================================
// DOMAIN 3: VERTICALS, SELLERS, KYC & SHOP STAFF
// ============================================================================

Table verticals {
  id uuid [pk]
  code varchar(40) [unique, not null]
  name varchar(100) [not null]
  hindi_name varchar(100)
  icon varchar(60)
  description text
  fulfillment_workflow vertical_workflow_type [not null]
  required_kyc_docs kyc_doc_code[] [not null]
  special_rules text[] [not null]
  is_enabled boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sellers {
  id uuid [pk]
  owner_user_id uuid [not null, ref: > users.id]
  public_name varchar(160) [not null]
  business_type seller_business_type [not null, note: 'FOOD restricted to RESTAURANT/HOTEL/DHABA/BAKERY; no tiffin']
  primary_vertical_id uuid [not null, ref: > verticals.id]
  description text
  contact_phone varchar(15) [not null]
  email varchar(255)
  village_id uuid [not null, ref: > villages.id]
  shop_address varchar(255) [not null]
  pin_code varchar(10)
  status seller_account_status [not null, default: 'PENDING_APPROVAL']
  kyc_status kyc_status [not null, default: 'PENDING']
  is_open_now boolean [not null, default: false]
  is_paused boolean [not null, default: false]
  supports_delivery boolean [not null, default: true]
  supports_pickup boolean [not null, default: true]
  delivery_radius_km numeric(5,2) [not null, default: 5.00]
  minimum_order_amount numeric(12,2) [not null, default: 0.00]
  packaging_fee numeric(12,2) [not null, default: 0.00]
  delivery_fee numeric(12,2) [not null, default: 0.00]
  opening_time time
  closing_time time
  closed_days text[] [not null]
  fssai_number varchar(20)
  fssai_verified boolean [not null, default: false]
  gst_or_trade_number varchar(30)
  agri_license_number varchar(40)
  upi_id varchar(120)
  bank_account_holder varchar(120)
  bank_account_encrypted text
  bank_account_last4 varchar(4)
  ifsc_code varchar(11)
  commission_rate_bps integer [not null, default: 500]
  udhari_enabled boolean [not null, default: false]
  udhari_policy_acknowledged_at timestamptz
  banner_url text
  logo_initials varchar(4)
  rating_avg numeric(3,2) [not null, default: 0.00]
  review_count integer [not null, default: 0]
  suspension_reason text
  rejection_reason text
  kyc_change_request_notes text
  reviewed_by_user_id uuid [ref: > users.id]
  reviewed_at timestamptz
  joined_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table seller_verticals {
  seller_id uuid [not null, ref: > sellers.id]
  vertical_id uuid [not null, ref: > verticals.id]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, vertical_id) [pk]
  }
}

Table seller_serviceable_villages {
  seller_id uuid [not null, ref: > sellers.id]
  village_id uuid [not null, ref: > villages.id]
  custom_delivery_fee numeric(12,2)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, village_id) [pk]
  }
}

Table seller_kyc_documents {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  doc_code kyc_doc_code [not null]
  label varchar(100) [not null]
  document_number_encrypted text
  document_number_masked varchar(40)
  file_url text [not null]
  file_name varchar(200) [not null]
  status kyc_status [not null, default: 'PENDING']
  rejection_reason text
  reviewed_by_user_id uuid [ref: > users.id]
  reviewed_at timestamptz
  uploaded_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, doc_code) [unique]
  }
}

Table seller_kyc_document_events {
  id uuid [pk]
  kyc_document_id uuid [not null, ref: > seller_kyc_documents.id]
  status kyc_status [not null]
  actor_user_id uuid [not null, ref: > users.id]
  note text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table seller_staff_members {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  user_id uuid [ref: > users.id]
  full_name varchar(120) [not null]
  phone varchar(15) [not null]
  staff_role seller_staff_role [not null]
  is_available boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TableGroup Sellers_KYC_Staff {
  verticals
  sellers
  seller_verticals
  seller_serviceable_villages
  seller_kyc_documents
  seller_kyc_document_events
  seller_staff_members
}

// ============================================================================
// DOMAIN 4: UNIVERSAL PRODUCT CATALOG & 8 CENTRALIZED MASTERS
// ============================================================================

Table categories {
  id uuid [pk]
  vertical_id uuid [not null, ref: > verticals.id]
  parent_id uuid [ref: > categories.id]
  name varchar(120) [not null]
  hindi_name varchar(120)
  slug varchar(140) [unique, not null]
  icon varchar(60)
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table brands {
  id uuid [pk]
  code varchar(40) [unique]
  name varchar(120) [unique, not null]
  manufacturer varchar(160)
  description text
  is_verified boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table brand_verticals {
  brand_id uuid [not null, ref: > brands.id]
  vertical_id uuid [not null, ref: > verticals.id]

  Indexes {
    (brand_id, vertical_id) [pk]
  }
}

Table units {
  id uuid [pk]
  name varchar(80) [not null]
  hindi_name varchar(80)
  symbol varchar(20) [unique, not null]
  family unit_family [not null]
  base_unit varchar(20)
  conversion_factor numeric(12,4)
  allow_decimal boolean [not null, default: false]
  allow_seller_local_override boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table category_allowed_units {
  category_id uuid [not null, ref: > categories.id]
  unit_id uuid [not null, ref: > units.id]

  Indexes {
    (category_id, unit_id) [pk]
  }
}

Table attributes {
  id uuid [pk]
  name varchar(100) [not null]
  hindi_name varchar(100)
  slug varchar(120) [unique, not null]
  data_type attribute_data_type [not null]
  allowed_options jsonb
  unit_suffix varchar(20)
  is_required boolean [not null, default: false]
  is_filterable boolean [not null, default: true]
  is_variant_axis boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table category_attributes {
  category_id uuid [not null, ref: > categories.id]
  attribute_id uuid [not null, ref: > attributes.id]
  is_required_override boolean

  Indexes {
    (category_id, attribute_id) [pk]
  }
}

Table option_groups {
  id uuid [pk]
  name varchar(120) [not null]
  hindi_name varchar(120)
  vertical_id uuid [ref: > verticals.id]
  category_id uuid [ref: > categories.id]
  selection_type selection_type [not null]
  is_required boolean [not null, default: false]
  min_select integer [not null, default: 0]
  max_select integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table option_group_items {
  id uuid [pk]
  option_group_id uuid [not null, ref: > option_groups.id]
  label varchar(120) [not null]
  price_delta numeric(12,2) [not null, default: 0.00]
  diet_type diet_type
  is_default boolean [not null, default: false]
  is_available boolean [not null, default: true]
  sort_order integer [not null, default: 0]
}

Table packaging_masters {
  id uuid [pk]
  code varchar(40) [unique, not null]
  name varchar(120) [not null]
  hindi_name varchar(120)
  material_type packaging_material_type [not null]
  capacity_label varchar(60) [not null]
  unit_id uuid [ref: > units.id]
  fee_amount numeric(12,2) [not null, default: 0.00]
  is_food_grade boolean [not null, default: false]
  is_eco_friendly boolean [not null, default: false]
  is_leak_proof boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table availability_stock_configs {
  id uuid [pk]
  code varchar(40) [unique, not null]
  name varchar(120) [not null]
  vertical_id uuid [not null, ref: > verticals.id]
  category_id uuid [ref: > categories.id]
  workflow_mode availability_workflow_mode [not null]
  service_slots text[] [not null]
  prep_time_minutes integer
  daily_batch_limit integer
  default_low_stock_threshold numeric(10,3) [not null, default: 5.000]
  max_qty_per_order numeric(10,3) [not null, default: 20.000]
  auto_disable_on_zero_stock boolean [not null, default: true]
  allow_pre_order boolean [not null, default: false]
  restock_lead_hours integer
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table products {
  id uuid [pk]
  sku_code varchar(64) [unique, not null]
  vertical_id uuid [not null, ref: > verticals.id]
  category_id uuid [not null, ref: > categories.id]
  subcategory_id uuid [ref: > categories.id]
  brand_id uuid [ref: > brands.id]
  default_unit_id uuid [not null, ref: > units.id]
  default_packaging_id uuid [ref: > packaging_masters.id]
  availability_config_id uuid [ref: > availability_stock_configs.id]
  tax_slab_id uuid [ref: > tax_slabs.id]
  name varchar(200) [not null]
  hindi_name varchar(200)
  description text
  diet_type diet_type
  image_url text
  is_universal_template boolean [not null, default: false]
  created_by_seller_id uuid [ref: > sellers.id]
  moderation_status moderation_status [not null, default: 'PENDING_REVIEW']
  moderation_notes text
  moderated_by_user_id uuid [ref: > users.id]
  moderated_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table product_attribute_values {
  id uuid [pk]
  product_id uuid [not null, ref: > products.id]
  attribute_id uuid [not null, ref: > attributes.id]
  value_text text
  value_number numeric(12,4)
  value_boolean boolean
  value_json jsonb

  Indexes {
    (product_id, attribute_id) [unique]
  }
}

Table product_variants {
  id uuid [pk]
  product_id uuid [not null, ref: > products.id]
  sku varchar(64) [unique, not null]
  label varchar(120) [not null]
  unit_id uuid [not null, ref: > units.id]
  unit_quantity numeric(10,3) [not null]
  variant_attributes jsonb [not null]
  default_mrp numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table product_option_groups {
  product_id uuid [not null, ref: > products.id]
  option_group_id uuid [not null, ref: > option_groups.id]
  sort_order integer [not null, default: 0]

  Indexes {
    (product_id, option_group_id) [pk]
  }
}

TableGroup Universal_Catalog_Masters {
  categories
  brands
  brand_verticals
  units
  category_allowed_units
  attributes
  category_attributes
  option_groups
  option_group_items
  packaging_masters
  availability_stock_configs
  products
  product_attribute_values
  product_variants
  product_option_groups
}

// ============================================================================
// DOMAIN 5: SELLER LISTINGS & KIRANA INVENTORY
// ============================================================================

Table seller_product_listings {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  product_id uuid [not null, ref: > products.id]
  variant_id uuid [ref: > product_variants.id]
  seller_sku varchar(64)
  mrp_price numeric(12,2) [not null]
  selling_price numeric(12,2) [not null]
  inventory_mode inventory_mode [not null]
  quantity_mode quantity_mode [not null, default: 'FIXED_PACK']
  predefined_quantity_options jsonb
  min_quantity numeric(10,3) [not null, default: 1.000]
  quantity_step numeric(10,3) [not null, default: 1.000]
  quantity_precision smallint [not null, default: 0]
  variable_weight boolean [not null, default: false]
  local_unit_label varchar(40)
  local_unit_conversion_grams numeric(10,2)
  local_unit_note varchar(200)
  prep_time_minutes integer
  lead_time_days integer
  track_stock boolean [not null, default: true]
  stock_quantity numeric(10,3) [not null, default: 0.000]
  reserved_quantity numeric(10,3) [not null, default: 0.000]
  low_stock_threshold numeric(10,3) [not null, default: 5.000]
  shelf_location varchar(80)
  batch_number varchar(60)
  expiry_date date
  supplier_name varchar(140)
  is_available boolean [not null, default: true]
  is_active boolean [not null, default: true]
  moderation_status moderation_status [not null, default: 'APPROVED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table inventory_stock_movements {
  id uuid [pk]
  seller_listing_id uuid [not null, ref: > seller_product_listings.id]
  seller_id uuid [not null, ref: > sellers.id]
  movement_type stock_movement_type [not null]
  quantity_delta numeric(10,3) [not null]
  quantity_before numeric(10,3) [not null]
  quantity_after numeric(10,3) [not null]
  reference_type varchar(40)
  reference_id uuid
  reason text
  performed_by_user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table seller_bulk_inventory_jobs {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  initiated_by_user_id uuid [not null, ref: > users.id]
  affected_listings_count integer [not null]
  payload_summary jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
}

TableGroup Seller_Inventory {
  seller_product_listings
  inventory_stock_movements
  seller_bulk_inventory_jobs
}

// ============================================================================
// DOMAIN 6: CART
// ============================================================================

Table carts {
  id uuid [pk]
  customer_id uuid [unique, not null, ref: - users.id]
  seller_id uuid [ref: > sellers.id]
  village_id uuid [ref: > villages.id]
  fulfilment_mode fulfilment_mode [not null, default: 'DELIVERY']
  coupon_id uuid [ref: > offers_coupons.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [not null, ref: > carts.id]
  seller_listing_id uuid [not null, ref: > seller_product_listings.id]
  quantity numeric(10,3) [not null]
  selected_options jsonb [not null]
  customer_note varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TableGroup Shopping_Cart {
  carts
  cart_items
}

// ============================================================================
// DOMAIN 7: ORDERS, HISTORY, CANCELLATIONS & RETURNS
// ============================================================================

Table orders {
  id uuid [pk]
  order_number varchar(30) [unique, not null]
  customer_id uuid [not null, ref: > users.id]
  seller_id uuid [not null, ref: > sellers.id]
  village_id uuid [not null, ref: > villages.id]
  fulfilment_mode fulfilment_mode [not null]
  delivery_address_id uuid [ref: > customer_addresses.id]
  delivery_address_snapshot jsonb
  delivery_note text
  status order_status [not null, default: 'PLACED']
  payment_method payment_method [not null]
  payment_status payment_status [not null, default: 'PENDING']
  coupon_id uuid [ref: > offers_coupons.id]
  coupon_code_snapshot varchar(40)
  item_subtotal numeric(12,2) [not null]
  item_discount numeric(12,2) [not null, default: 0.00]
  coupon_discount numeric(12,2) [not null, default: 0.00]
  delivery_fee numeric(12,2) [not null, default: 0.00]
  packaging_fee numeric(12,2) [not null, default: 0.00]
  tax_amount numeric(12,2) [not null, default: 0.00]
  tax_label_snapshot varchar(80)
  platform_fee numeric(12,2) [not null, default: 0.00]
  total_amount numeric(12,2) [not null]
  fee_rule_id uuid [ref: > fee_rules.id]
  commission_rate_bps_snapshot integer [not null, default: 0]
  commission_amount numeric(12,2) [not null, default: 0.00]
  is_shadow_commission boolean [not null, default: false]
  estimated_delivery_minutes integer
  accept_deadline_at timestamptz
  accepted_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  seller_listing_id uuid [ref: > seller_product_listings.id]
  product_id uuid [ref: > products.id]
  variant_id uuid [ref: > product_variants.id]
  product_name_snapshot varchar(200) [not null]
  vertical_code_snapshot varchar(40) [not null]
  sku_snapshot varchar(64)
  variant_label_snapshot varchar(120)
  variant_attributes_snapshot jsonb [not null]
  selected_options_snapshot jsonb [not null]
  mrp_unit_price numeric(12,2)
  unit_price numeric(12,2) [not null]
  item_discount numeric(12,2) [not null, default: 0.00]
  requested_quantity numeric(10,3) [not null]
  requested_unit_label varchar(60) [not null]
  line_total numeric(12,2) [not null]
  returned_quantity numeric(10,3) [not null, default: 0.000]
  customer_note varchar(255)
  created_at timestamptz [not null, default: `now()`]
}

Table order_status_history {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  from_status order_status
  to_status order_status [not null]
  actor_user_id uuid [ref: > users.id]
  actor_role varchar(40) [not null]
  reason text
  created_at timestamptz [not null, default: `now()`]
}

Table order_cancellations {
  id uuid [pk]
  order_id uuid [unique, not null, ref: - orders.id]
  cancelled_by_actor cancelled_by_actor [not null]
  cancelled_by_user_id uuid [ref: > users.id]
  policy_rule_id uuid [ref: > cancellation_policy_rules.id]
  reason text [not null]
  penalty_amount numeric(12,2) [not null, default: 0.00]
  refund_eligible boolean [not null, default: false]
  notes text
  cancelled_at timestamptz [not null, default: `now()`]
}

Table order_returns {
  id uuid [pk]
  return_number varchar(30) [unique, not null]
  order_id uuid [not null, ref: > orders.id]
  requested_by_user_id uuid [not null, ref: > users.id]
  status return_status [not null, default: 'REQUESTED']
  reason text [not null]
  notes text
  requested_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table order_return_items {
  id uuid [pk]
  order_return_id uuid [not null, ref: > order_returns.id]
  order_item_id uuid [not null, ref: > order_items.id]
  quantity numeric(10,3) [not null]
  refund_amount numeric(12,2) [not null]
  condition_note text
}

TableGroup Orders_Fulfilment_Returns {
  orders
  order_items
  order_status_history
  order_cancellations
  order_returns
  order_return_items
}

// ============================================================================
// DOMAIN 8: DELIVERY FLEET & PICKUP
// ============================================================================

Table delivery_partners {
  id uuid [pk]
  user_id uuid [unique, not null, ref: - users.id]
  village_id uuid [not null, ref: > villages.id]
  vehicle_type vehicle_type [not null]
  vehicle_number varchar(30)
  kyc_verified boolean [not null, default: false]
  status delivery_partner_status [not null, default: 'OFFLINE']
  completed_deliveries integer [not null, default: 0]
  rating_avg numeric(3,2) [not null, default: 0.00]
  joined_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table order_deliveries {
  id uuid [pk]
  order_id uuid [unique, not null, ref: - orders.id]
  fulfilment_type delivery_fulfilment_type [not null]
  seller_staff_id uuid [ref: > seller_staff_members.id]
  delivery_partner_id uuid [ref: > delivery_partners.id]
  runner_name_snapshot varchar(120)
  runner_phone_snapshot varchar(15)
  pickup_code varchar(12)
  status delivery_status [not null, default: 'UNASSIGNED']
  assigned_at timestamptz
  picked_up_at timestamptz
  delivered_at timestamptz
  failed_reason text
  delivery_proof_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TableGroup Delivery_Pickup {
  delivery_partners
  order_deliveries
}

// ============================================================================
// DOMAIN 9: PAYMENTS, REFUNDS, TAXES, COMMISSION & SETTLEMENTS
// ============================================================================

Table fee_rules {
  id uuid [pk]
  name varchar(120) [not null]
  vertical_id uuid [ref: > verticals.id]
  commission_bps integer [not null]
  platform_fee numeric(12,2) [not null, default: 0.00]
  effective_from timestamptz [not null]
  effective_until timestamptz
  is_pilot_shadow_mode boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table tax_slabs {
  id uuid [pk]
  name varchar(120) [not null]
  vertical_id uuid [ref: > verticals.id]
  gst_percent numeric(5,2) [not null]
  hsn_prefix varchar(16)
  is_inclusive boolean [not null, default: true]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table payment_transactions {
  id uuid [pk]
  transaction_ref varchar(60) [unique, not null]
  order_id uuid [not null, ref: > orders.id]
  customer_id uuid [not null, ref: > users.id]
  seller_id uuid [not null, ref: > sellers.id]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  gateway_name varchar(60)
  gateway_ref varchar(120)
  status payment_tx_status [not null]
  failure_code varchar(60)
  failure_reason text
  platform_fee_component numeric(12,2) [not null, default: 0.00]
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table refunds {
  id uuid [pk]
  refund_number varchar(40) [unique, not null]
  order_id uuid [not null, ref: > orders.id]
  payment_transaction_id uuid [ref: > payment_transactions.id]
  support_case_id uuid [ref: > support_cases.id]
  order_return_id uuid [ref: > order_returns.id]
  amount numeric(12,2) [not null]
  channel refund_channel [not null]
  status refund_status [not null, default: 'INITIATED']
  reason text [not null]
  rejection_reason text
  failure_reason text
  gateway_refund_ref varchar(120)
  initiated_by_user_id uuid [not null, ref: > users.id]
  initiated_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
}

Table seller_settlements {
  id uuid [pk]
  settlement_number varchar(40) [unique, not null]
  seller_id uuid [not null, ref: > sellers.id]
  period_start date [not null]
  period_end date [not null]
  period_label varchar(60) [not null]
  orders_count integer [not null]
  gross_amount numeric(12,2) [not null]
  commission_amount numeric(12,2) [not null]
  refund_deductions numeric(12,2) [not null, default: 0.00]
  other_deductions numeric(12,2) [not null, default: 0.00]
  platform_fee_deduction numeric(12,2) [not null, default: 0.00]
  net_payable numeric(12,2) [not null]
  payment_mode settlement_payment_mode [not null]
  utr_number varchar(64) [unique]
  status settlement_status [not null, default: 'PENDING']
  settlement_date date
  settled_at timestamptz
  notes text
  created_by_user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table seller_settlement_orders {
  id uuid [pk]
  settlement_id uuid [not null, ref: > seller_settlements.id]
  order_id uuid [unique, not null, ref: - orders.id]
  order_gross_amount numeric(12,2) [not null]
  order_commission_amount numeric(12,2) [not null]
  order_refund_deduction numeric(12,2) [not null, default: 0.00]
  order_net_amount numeric(12,2) [not null]
}

TableGroup Finance_Payments_Settlements {
  fee_rules
  tax_slabs
  payment_transactions
  refunds
  seller_settlements
  seller_settlement_orders
}

// ============================================================================
// DOMAIN 10: SELLER-MANAGED UDHARI (RURAL CREDIT)
// ============================================================================

Table customer_credit_profiles {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  customer_id uuid [not null, ref: > users.id]
  status credit_profile_status [not null, default: 'ACTIVE']
  credit_limit numeric(12,2) [not null, default: 0.00]
  outstanding_balance numeric(12,2) [not null, default: 0.00]
  overdue_amount numeric(12,2) [not null, default: 0.00]
  default_due_days integer [not null, default: 15]
  last_payment_at timestamptz
  internal_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, customer_id) [unique]
  }
}

Table credit_repayments {
  id uuid [pk]
  repayment_reference varchar(40) [unique, not null]
  credit_profile_id uuid [not null, ref: > customer_credit_profiles.id]
  seller_id uuid [not null, ref: > sellers.id]
  customer_id uuid [not null, ref: > users.id]
  amount numeric(12,2) [not null]
  method repayment_method [not null]
  reference_number varchar(80)
  note text
  recorded_by_user_id uuid [not null, ref: > users.id]
  received_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table credit_ledger_entries {
  id uuid [pk]
  ledger_reference varchar(40) [unique, not null]
  credit_profile_id uuid [not null, ref: > customer_credit_profiles.id]
  seller_id uuid [not null, ref: > sellers.id]
  customer_id uuid [not null, ref: > users.id]
  order_id uuid [ref: > orders.id]
  repayment_id uuid [ref: > credit_repayments.id]
  reversed_entry_id uuid [ref: > credit_ledger_entries.id]
  entry_type credit_entry_type [not null]
  direction credit_entry_direction [not null]
  amount numeric(12,2) [not null]
  running_balance numeric(12,2) [not null]
  due_date timestamptz
  is_overdue boolean [not null, default: false]
  status credit_entry_status [not null, default: 'POSTED']
  reason text
  recorded_by_user_id uuid [not null, ref: > users.id]
  posted_at timestamptz [not null, default: `now()`]
}

Table credit_disputes {
  id uuid [pk]
  credit_profile_id uuid [not null, ref: > customer_credit_profiles.id]
  ledger_entry_id uuid [not null, ref: > credit_ledger_entries.id]
  seller_id uuid [not null, ref: > sellers.id]
  customer_id uuid [not null, ref: > users.id]
  reason_code credit_dispute_reason [not null]
  description text [not null]
  status credit_dispute_status [not null, default: 'OPEN']
  resolution_note text
  resolved_by_user_id uuid [ref: > users.id]
  opened_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
}

TableGroup Seller_Udhari_Credit {
  customer_credit_profiles
  credit_repayments
  credit_ledger_entries
  credit_disputes
}

// ============================================================================
// DOMAIN 11: OFFERS, REVIEWS & SUPPORT
// ============================================================================

Table offers_coupons {
  id uuid [pk]
  code varchar(40) [unique, not null]
  title varchar(160) [not null]
  discount_type discount_type [not null]
  discount_value numeric(12,2) [not null]
  min_order_amount numeric(12,2) [not null, default: 0.00]
  max_discount_amount numeric(12,2)
  vertical_id uuid [ref: > verticals.id]
  village_id uuid [ref: > villages.id]
  seller_id uuid [ref: > sellers.id]
  funded_by offer_funding_source [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz [not null]
  usage_limit integer [not null]
  per_customer_limit integer [not null, default: 1]
  used_count integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table coupon_redemptions {
  id uuid [pk]
  coupon_id uuid [not null, ref: > offers_coupons.id]
  order_id uuid [unique, not null, ref: - orders.id]
  customer_id uuid [not null, ref: > users.id]
  discount_applied numeric(12,2) [not null]
  redeemed_at timestamptz [not null, default: `now()`]
}

Table reviews {
  id uuid [pk]
  order_id uuid [unique, not null, ref: - orders.id]
  customer_id uuid [not null, ref: > users.id]
  seller_id uuid [not null, ref: > sellers.id]
  rating smallint [not null]
  comment text
  status review_status [not null, default: 'PUBLISHED']
  flag_reason text
  moderation_notes text
  moderated_by_user_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table support_cases {
  id uuid [pk]
  case_number varchar(30) [unique, not null]
  order_id uuid [ref: > orders.id]
  customer_id uuid [not null, ref: > users.id]
  seller_id uuid [ref: > sellers.id]
  issue_type support_issue_type [not null]
  status support_case_status [not null, default: 'OPEN']
  disputed_amount numeric(12,2) [not null, default: 0.00]
  approved_refund_amount numeric(12,2)
  description text [not null]
  resolution_notes text
  assigned_admin_id uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TableGroup Offers_Reviews_Support {
  offers_coupons
  coupon_redemptions
  reviews
  support_cases
}

// ============================================================================
// DOMAIN 12: SELLER SAFETY, QUALITY & ASSESSMENT SYSTEM
// ============================================================================

Table safety_training_modules {
  id uuid [pk]
  track safety_track [not null]
  module_number integer [not null]
  title varchar(180) [not null]
  hindi_title varchar(180)
  duration_minutes integer [not null]
  is_mandatory boolean [not null, default: true]
  summary text [not null]
  key_standards jsonb [not null]
  do_practices jsonb [not null]
  dont_practices jsonb [not null]
  critical_control_point text [not null]
  village_practical_tip text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (track, module_number) [unique]
  }
}

Table seller_training_completions {
  seller_id uuid [not null, ref: > sellers.id]
  module_id uuid [not null, ref: > safety_training_modules.id]
  completed_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, module_id) [pk]
  }
}

Table safety_checklist_items {
  id uuid [pk]
  track safety_track [not null]
  section varchar(100) [not null]
  title varchar(200) [not null]
  hindi_title varchar(200)
  weight integer [not null, default: 1]
  is_critical boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table seller_checklist_submissions {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  submission_date date [not null]
  track safety_track [not null]
  checked_item_ids jsonb [not null]
  score_percent numeric(5,2) [not null]
  completed_critical_count integer [not null]
  total_critical_count integer [not null]
  notes text
  submitted_at timestamptz [not null, default: `now()`]

  Indexes {
    (seller_id, submission_date) [unique]
  }
}

Table safety_exam_questions {
  id uuid [pk]
  track safety_track [not null]
  topic varchar(120) [not null]
  question text [not null]
  hindi_hint text
  options jsonb [not null]
  correct_index smallint [not null]
  explanation text [not null]
  is_active boolean [not null, default: true]
}

Table seller_exam_attempts {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  track safety_track [not null]
  score_percent numeric(5,2) [not null]
  correct_count integer [not null]
  total_questions integer [not null]
  passed boolean [not null]
  time_taken_seconds integer [not null]
  weak_topics jsonb [not null]
  answers jsonb [not null]
  submitted_at timestamptz [not null, default: `now()`]
}

Table seller_safety_profiles {
  seller_id uuid [pk, ref: - sellers.id]
  track safety_track [not null]
  badge_level certification_badge_level [not null, default: 'IN_PROGRESS']
  overall_compliance_score numeric(5,2) [not null, default: 0.00]
  retraining_required boolean [not null, default: false]
  retraining_reason text
  suspended_for_safety boolean [not null, default: false]
  certificate_number varchar(60) [unique]
  certified_at timestamptz
  certificate_valid_until timestamptz
  updated_at timestamptz [not null, default: `now()`]
}

Table safety_inspection_audits {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id]
  inspector_user_id uuid [not null, ref: > users.id]
  score_percent numeric(5,2) [not null]
  outcome inspection_outcome [not null]
  remarks text [not null]
  findings jsonb [not null]
  inspected_at timestamptz [not null, default: `now()`]
}

TableGroup Safety_Quality_Assessment {
  safety_training_modules
  seller_training_completions
  safety_checklist_items
  seller_checklist_submissions
  safety_exam_questions
  seller_exam_attempts
  seller_safety_profiles
  safety_inspection_audits
}

// ============================================================================
// DOMAIN 13: NOTIFICATIONS, BROADCASTS, CMS, POLICIES, SETTINGS & AUDIT
// ============================================================================

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  seller_id uuid [ref: > sellers.id]
  order_id uuid [ref: > orders.id]
  channel notification_channel [not null, default: 'IN_APP']
  notification_type varchar(60) [not null]
  title varchar(160) [not null]
  body text [not null]
  metadata jsonb
  is_read boolean [not null, default: false]
  read_at timestamptz
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table broadcast_campaigns {
  id uuid [pk]
  title varchar(160) [not null]
  message text [not null]
  channel notification_channel [not null]
  audience broadcast_audience [not null]
  target_village_id uuid [ref: > villages.id]
  priority broadcast_priority [not null, default: 'NORMAL']
  estimated_reach integer [not null, default: 0]
  delivered_count integer [not null, default: 0]
  status broadcast_status [not null, default: 'DRAFT']
  scheduled_for timestamptz
  sent_at timestamptz
  created_by_user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table cms_banners {
  id uuid [pk]
  title varchar(160) [not null]
  subtitle varchar(240)
  placement banner_placement [not null]
  target_vertical_id uuid [ref: > verticals.id]
  target_village_id uuid [ref: > villages.id]
  cta_label varchar(60)
  accent_color varchar(20)
  valid_from timestamptz [not null]
  valid_until timestamptz [not null]
  priority integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table cms_policy_pages {
  id uuid [pk]
  slug varchar(60) [unique, not null]
  title varchar(160) [not null]
  version varchar(20) [not null]
  summary text
  content text [not null]
  updated_by_user_id uuid [not null, ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table cancellation_policy_rules {
  id uuid [pk]
  actor cancelled_by_actor [not null]
  code varchar(60) [unique, not null]
  label varchar(140) [not null]
  free_cancel_window_mins integer [not null, default: 5]
  penalty_percent numeric(5,2) [not null, default: 0.00]
  auto_refund_eligible boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table platform_settings {
  id smallint [pk, default: 1]
  platform_name varchar(120) [not null]
  tagline varchar(200)
  support_phone varchar(20) [not null]
  whatsapp_support varchar(20)
  default_delivery_enabled boolean [not null, default: true]
  default_pickup_enabled boolean [not null, default: true]
  allow_multi_vertical_sellers boolean [not null, default: true]
  auto_cancel_unaccepted_mins integer [not null, default: 15]
  food_prep_sla_mins integer [not null, default: 30]
  maintenance_mode boolean [not null, default: false]
  maintenance_message text
  updated_by_user_id uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table audit_logs {
  id uuid [pk]
  actor_user_id uuid [ref: > users.id]
  actor_role varchar(40) [not null]
  action_type varchar(80) [not null]
  target_entity varchar(60) [not null]
  target_id varchar(64) [not null]
  ip_address inet
  details text [not null]
  reason text
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
}

TableGroup Notifications_CMS_Settings_Audit {
  notifications
  broadcast_campaigns
  cms_banners
  cms_policy_pages
  cancellation_policy_rules
  platform_settings
  audit_logs
}
