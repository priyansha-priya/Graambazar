// GramBazaar Marketplace — Production PostgreSQL ER Diagram (DBML)
// Compatible with https://dbdiagram.io
// Technology Target: PostgreSQL 16+ | Node.js | Express | TypeScript | Prisma ORM
// Total Domains: 13 | Total Tables: 74
// Monetary Standard: numeric(12,2) in INR | Quantities: numeric(10,3) | Timestamps: timestamptz

Project GramBazaar {
  database_type: 'PostgreSQL'
  Note: 'Multi-village Food (Restaurants/Hotels/Dhabas/Bakeries only — no tiffin services) and Grocery (Kirana) Marketplace with Universal Catalog, Seller Inventory, Udhari Credit, Settlements, and Safety Assessment.'
}

// ============================================================================
// ENUMS
// ============================================================================

Enum user_status {
  ACTIVE
  BLOCKED
  SUSPENDED
  INACTIVE
}

Enum role_code {
  CUSTOMER
  SELLER_OWNER
  SELLER_STAFF
  SELLER_RUNNER
  DELIVERY_PARTNER
  SUPER_ADMIN
  ADMIN_OPS
  ADMIN_FINANCE
  ADMIN_SUPPORT
}

Enum auth_token_type {
  REFRESH_SESSION
  PASSWORD_RESET
  PHONE_OTP
  EMAIL_VERIFY
}

Enum address_label {
  HOME
  WORK
  OTHER
}

Enum vertical_workflow_type {
  FOOD_KITCHEN
  GROCERY_WEIGHT
  PHYSICAL_RETAIL
  MADE_TO_ORDER
}

Enum seller_business_type {
  RESTAURANT
  HOTEL
  DHABA
  BAKERY
  KIRANA
  GENERAL_STORE
  HARDWARE_STORE
  ELECTRONICS_DEALER
  CLOTHING_STORE
  FURNITURE_SHOP
  AGRI_KENDRA
  MULTI_CATEGORY
}

Enum seller_account_status {
  DRAFT
  PENDING_APPROVAL
  KYC_PENDING
  KYC_UNDER_REVIEW
  APPROVED
  ACTIVE
  INACTIVE
  PAUSED
  SUSPENDED
  REJECTED
}

Enum kyc_status {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

Enum kyc_doc_code {
  FSSAI
  AADHAAR
  PAN
  STORE_PHOTO
  GST_TRADE
  AGRI_LICENSE
}

Enum seller_staff_role {
  MANAGER
  CASHIER
  SHOP_RUNNER
  DELIVERY_STAFF
  FAMILY_HELPER
}

Enum unit_family {
  WEIGHT
  VOLUME
  LENGTH
  COUNT
  PORTION
  BULK_PACK
  AREA
}

Enum attribute_data_type {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
  DIMENSIONS
}

Enum selection_type {
  SINGLE
  MULTIPLE
}

Enum diet_type {
  VEG
  NON_VEG
  EGG
}

Enum packaging_material_type {
  FOOD_CONTAINER
  THERMAL_BOX
  ECO_BAG
  SEALED_POUCH
  BOTTLE_JAR
  CORRUGATED_CARTON
}

Enum availability_workflow_mode {
  TRACKED_INVENTORY
  DAILY_PREP_SLOTS
  MADE_TO_ORDER
  UNLIMITED_SERVICE
}

Enum inventory_mode {
  QUANTITY_STOCK
  WEIGHT_STOCK
  VARIANT_STOCK
  PREPARED_FOOD
  MADE_TO_ORDER
}

Enum quantity_mode {
  FIXED_PACK
  PREDEFINED_OPTIONS
  CUSTOM_QUANTITY
}

Enum moderation_status {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

Enum stock_movement_type {
  INITIAL_STOCK
  ORDER_RESERVED
  ORDER_DEDUCTED
  ORDER_CANCELLED_RESTORE
  RETURN_RESTOCK
  MANUAL_RESTOCK
  BULK_UPDATE
  DAMAGE_WRITE_OFF
  EXPIRY_WRITE_OFF
  AUDIT_ADJUSTMENT
}

Enum fulfilment_mode {
  DELIVERY
  PICKUP
}

Enum order_status {
  PLACED
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
  CANCELLED
  DELIVERY_FAILED
  RETURNED
  REFUNDED
}

Enum payment_method {
  COD
  SELLER_UPI
  PLATFORM_UPI
  UDHAR
}

Enum payment_status {
  PENDING
  COLLECTED
  SETTLED
  REVERSED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

Enum payment_tx_status {
  INITIATED
  CAPTURED
  PENDING_COD
  FAILED
  REVERSED
  REFUNDED
}

Enum cancelled_by_actor {
