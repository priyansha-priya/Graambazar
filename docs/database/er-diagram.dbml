}

Enum settlement_status {
  PENDING
  PROCESSING
  SETTLED
  FAILED
}

Enum settlement_payment_mode {
  UPI
  NEFT_IMPS
  CASH_SETTLEMENT
}

Enum credit_profile_status {
  ACTIVE
  DISABLED
  BLOCKED
}

Enum credit_entry_type {
  CREDIT_SALE
  REPAYMENT
