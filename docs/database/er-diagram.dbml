  SELLER
  ADMIN
  SYSTEM
}

Enum return_status {
  REQUESTED
  APPROVED
  PICKED_UP
  RECEIVED
  REJECTED
}

Enum refund_status {
  INITIATED
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

Enum refund_channel {
  ORIGINAL_UPI
  BANK_TRANSFER
  UDHAR_REVERSAL
  CASH_SETTLEMENT
  STORE_CREDIT
}

Enum delivery_fulfilment_type {
  SELLER_RUNNER
  PLATFORM_PARTNER
  CUSTOMER_PICKUP
}

Enum delivery_status {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP_BY_CUSTOMER
  FAILED
}

Enum vehicle_type {
  CYCLE
  BIKE
  E_RICKSHAW
}

Enum delivery_partner_status {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
